# Copie para .env. Sem estas linhas, o painel responde só no próprio notebook.
# IP do notebook no Tailscale: tailscale ip -4
VIDA_PAINEL_TAILSCALE_IP=100.x.y.z
# Nomes aceitos, separados por vírgula: nome curto e nome completo do MagicDNS.
VIDA_PAINEL_REMOTE_NAMES=nome-do-notebook,nome-do-notebook.sua-rede.ts.net
